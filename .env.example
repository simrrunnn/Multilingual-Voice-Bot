# Copy this file to .env and fill in real values. Never commit .env.
# See README.md for where to obtain each credential.

# --- LiveKit (voice orchestration + SIP) ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Twilio (inbound phone number, connected to LiveKit via SIP trunk) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Sarvam AI (speech-to-text + text-to-speech) ---
# Used instead of Deepgram: Sarvam has native STT/TTS coverage for all five
# required languages (en, hi, mr, ta, kn); Deepgram does not. See README
# "Tech Stack" for the full rationale.
SARVAM_API_KEY=

# --- OpenRouter (LLM) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# --- Supabase (persistence) ---
# Use the service_role key on the backend only. Never expose it to a frontend.
SUPABASE_URL=
SUPABASE_KEY=

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
